# OpenAI (required for analysis, detection, and answer generation)
OPENAI_API_KEY=

# Strong text model used for answer generation and reviews
OPENAI_MODEL=gpt-4.1

# Fast model used for question detection
OPENAI_FAST_MODEL=gpt-4.1-mini

# Deepgram (optional). If missing, the app falls back to manual caption input.
DEEPGRAM_API_KEY=

# Local SQLite database
DATABASE_URL="file:./dev.db"
